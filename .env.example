# --- server ---
HOST=127.0.0.1
PORT=20129

# --- upstream ---
# Origin swap: incoming path + query are forwarded VERBATIM onto this origin.
UPSTREAM_ORIGIN=https://cli-chat-proxy.grok.com
UPSTREAM_TIMEOUT_MS=300000
BODY_LIMIT=25mb

# --- accounts (credentials source: 9Router SQLite, opened read-only) ---
ROUTER_DB_PATH=C:\Users\ngoti\AppData\Roaming\9router\db\data.sqlite

# --- pool state (own SQLite: health, sticky sessions, request history) ---
POOL_DB_PATH=./data/pool.db

# --- routing ---
# round-robin | least-used | random | premium-first
# premium-first: accounts flagged "premium": true (accounts.extra.json) serve all
# inference while healthy; the rest rotate when premiums cool down / fail.
POOL_STRATEGY=round-robin
# max upstream attempts per request (1 = no failover)
MAX_FAILOVERS=4
STICKY_TTL_MS=3600000

# --- resilience ---
HEALTH_PROBE_INTERVAL_MS=600000
REQUEST_RETENTION_DAYS=7

# --- client auth (empty = accept any client, e.g. Grok Build with its own bearer) ---
POOL_API_KEY=

# --- tracing: info | debug | wire ---
GROK_TRACE=info
GROK_TRACE_BODY=false
GROK_TRACE_HEADERS=true
GROK_TRACE_STREAM=true
TRACE_DIR=./traces

# --- header fill-ins for clients that omit them (Grok Build sends its own) ---
GROK_CLIENT_VERSION=1.0.13
GROK_TOKEN_AUTH=xai-grok-cli
GROK_CLIENT_IDENTIFIER=grok-shell
GROK_CLIENT_MODE=interactive
DEFAULT_MODEL=grok-4.5

# --- CLI UX patch: upstream reports subscriptionTier=null on /v1/user, which the ---
# --- CLI treats as Free (no thinking display, upgrade banner). Non-empty value  ---
# --- patches ONLY that field; leave empty to disable the patch.                  ---
GROK_POOL_SUBSCRIPTION_TIER=SuperGrok

# --- login importer ---
LOGIN_ROOT=./.grok-logins
